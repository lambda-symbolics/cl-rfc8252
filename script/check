#!/bin/sh

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd -- "$root"

if [ ! -r "$root/.qlot/setup.lisp" ]; then
  printf '%s\n' 'cl-rfc8252 dependencies are missing; run ./script/bootstrap.' >&2
  exit 1
fi

exec sbcl --noinform --non-interactive \
  --load "$root/.qlot/setup.lisp" \
  --eval '(require :asdf)' \
    --eval '(asdf:load-asd (truename "cl-rfc8252.asd"))' \
    --eval '(asdf:test-system "cl-rfc8252")'
